diff --git a/src/peer_book.c b/src/peer_book.c
index 8f69bb4..59886aa 100644
--- a/src/peer_book.c
+++ b/src/peer_book.c
@@ -2,6 +2,7 @@
 
 #include "util.h"
 
+#include <ctype.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -45,6 +46,50 @@ int laser_peer_endpoint_valid(const char *endpoint)
     return 1;
 }
 
+static int ascii_equal_ignore_case(const char *left, const char *right)
+{
+    while (*left && *right) {
+        if (tolower((unsigned char)*left) !=
+            tolower((unsigned char)*right))
+            return 0;
+        left++;
+        right++;
+    }
+    return *left == '\0' && *right == '\0';
+}
+
+static int host_is_loopback(const char *host)
+{
+    return strncmp(host, "127.", 4) == 0 ||
+           strcmp(host, "::1") == 0 ||
+           strcmp(host, "[::1]") == 0 ||
+           ascii_equal_ignore_case(host, "localhost");
+}
+
+static int host_is_unspecified(const char *host)
+{
+    return strcmp(host, "0.0.0.0") == 0 ||
+           strcmp(host, "::") == 0 ||
+           strcmp(host, "[::]") == 0;
+}
+
+int laser_peer_endpoint_discoverable(const char *endpoint,
+                                     const char *source_address)
+{
+    if (!laser_peer_endpoint_valid(endpoint) || !source_address)
+        return 0;
+    const char *colon = strrchr(endpoint, ':');
+    size_t host_length = (size_t)(colon - endpoint);
+    if (host_length == 0 || host_length > LASER_PEER_ENDPOINT_MAX)
+        return 0;
+    char host[LASER_PEER_ENDPOINT_MAX + 1u];
+    memcpy(host, endpoint, host_length);
+    host[host_length] = '\0';
+    if (host_is_unspecified(host))
+        return 0;
+    return !host_is_loopback(host) || host_is_loopback(source_address);
+}
+
 int laser_peer_book_open(laser_peer_book_t *book,
                          const laser_network_t *network,
                          const char *data_dir)
