+typedef struct {
+    int valid;
+    uint8_t address[32];
+    uint8_t tip_hash[32];
+    uint64_t scanned_height;
+    uint64_t blocks;
+    uint64_t subsidy_photons;
+    uint64_t fee_photons;
+    uint64_t last_height;
+    uint64_t last_timestamp;
+    int has_last;
+} miner_metrics_cache_t;
+
+static int add_u64(uint64_t *total, uint64_t value)
+{
+    if (*total > UINT64_MAX - value)
+        return -1;
+    *total += value;
+    return 0;
+}
+
+static int miner_metrics_refresh(miner_metrics_cache_t *metrics,
+                                 const laser_block_store_t *store,
+                                 const uint8_t address[32])
+{
+    const laser_chain_tip_t *tip = laser_block_store_tip(store);
+    if (!metrics || !tip)
+        return -1;
+    miner_metrics_cache_t next;
+    uint64_t start = 0;
+    uint8_t active_hash[32];
+    if (metrics->valid && memcmp(metrics->address, address, 32) == 0 &&
+        metrics->scanned_height <= tip->height &&
+        laser_block_store_active_hash(store, metrics->scanned_height,
+                                      active_hash) == 0 &&
+        memcmp(active_hash, metrics->tip_hash, 32) == 0) {
+        next = *metrics;
+        start = metrics->scanned_height + 1;
+    } else {
+        memset(&next, 0, sizeof next);
+        memcpy(next.address, address, 32);
+    }
+    for (uint64_t height = start; height <= tip->height; height++) {
+        laser_block_t block;
+        if (laser_block_store_active_hash(store, height, active_hash) != 0 ||
+            laser_block_store_get_block(store, active_hash, &block) != 0)
+            return -1;
+        if (memcmp(block.header.miner_addr, address, 32) == 0) {
+            uint64_t fees = 0;
+            for (uint32_t i = 0; i < block.header.tx_count; i++) {
+                if (add_u64(&fees, block.txs[i].fee_photons) != 0) {
+                    laser_block_free(&block);
+                    return -1;
+                }
+            }
+            if (next.blocks == UINT64_MAX ||
+                add_u64(&next.subsidy_photons,
+                        laser_block_reward(height)) != 0 ||
+                add_u64(&next.fee_photons, fees) != 0) {
+                laser_block_free(&block);
+                return -1;
+            }
+            next.blocks++;
+            next.last_height = height;
+            next.last_timestamp = block.header.timestamp;
+            next.has_last = 1;
+        }
+        laser_block_free(&block);
+    }
+    next.valid = 1;
+    next.scanned_height = tip->height;
+    memcpy(next.tip_hash, tip->hash, 32);
+    *metrics = next;
+    return 0;
+}
