+static int cmd_v2_miner(int argc, char **argv)
+{
+    if (argc < 4) {
+        fprintf(stderr, "Usage: laser node miner <wallet-or-address> "
+                "--rpc HOST:PORT --datadir DIR [--json]\n");
+        return 2;
+    }
+    v2_cli_options_t options;
+    if (parse_v2_options(&options, argc, argv, 4) != 0 ||
+        !options.rpc_endpoint)
+        return 2;
+    uint8_t address[32];
+    if (resolve_address(address, argv[3]) != 0)
+        return 1;
+    char encoded[65], command[80], response[768], extra;
+    hex_encode(encoded, address, 32);
+    snprintf(command, sizeof command, "MINER %s", encoded);
+    if (laser_rpc_request(options.rpc_endpoint, options.data_dir, command,
+                          response, sizeof response) != 0) {
+        fprintf(stderr, "Cannot query miner metrics\n");
+        return 1;
+    }
+    unsigned long long confirmed, projected, pending_received, pending_spent;
+    unsigned long long blocks, subsidy, fees, total, last_height;
+    unsigned long long last_timestamp, next_reward;
+    int has_last;
+    if (sscanf(response,
+               "confirmed=%llu projected=%llu pending_received=%llu "
+               "pending_spent=%llu blocks=%llu subsidy=%llu fees=%llu "
+               "total=%llu last_height=%llu last_timestamp=%llu "
+               "has_last=%d next_reward=%llu %c",
+               &confirmed, &projected, &pending_received, &pending_spent,
+               &blocks, &subsidy, &fees, &total, &last_height,
+               &last_timestamp, &has_last, &next_reward, &extra) != 12) {
+        fprintf(stderr, "Malformed miner metrics response\n");
+        return 1;
+    }
+    if (options.json) {
+        printf("{\042address\042:\042%s\042,"
+               "\042confirmed_photons\042:\042%llu\042,"
+               "\042projected_photons\042:\042%llu\042,"
+               "\042pending_received_photons\042:\042%llu\042,"
+               "\042pending_spent_photons\042:\042%llu\042,"
+               "\042blocks_mined\042:%llu,"
+               "\042subsidy_photons\042:\042%llu\042,"
+               "\042fee_photons\042:\042%llu\042,"
+               "\042total_mined_photons\042:\042%llu\042,"
+               "\042has_last\042:%s,"
+               "\042last_height\042:%llu,"
+               "\042last_timestamp\042:%llu,"
+               "\042next_reward_photons\042:\042%llu\042}\n",
+               encoded, confirmed, projected, pending_received, pending_spent,
+               blocks, subsidy, fees, total, has_last ? "true" : "false",
+               last_height, last_timestamp, next_reward);
+    } else {
+        printf("Address: %s\nBlocks mined: %llu\n"
+               "Total mined: %llu photons (%llu subsidy + %llu fees)\n"
+               "Confirmed: %llu photons\nProjected: %llu photons\n"
+               "Pending received: %llu photons\nPending spent: %llu photons\n",
+               encoded, blocks, total, subsidy, fees, confirmed, projected,
+               pending_received, pending_spent);
+        if (has_last)
+            printf("Last mined: height %llu timestamp %llu\n",
+                   last_height, last_timestamp);
+        printf("Next block subsidy: %llu photons\n", next_reward);
+    }
+    return 0;
+}
